FROM node:22-bookworm-slim AS frontend-build

WORKDIR /app/frontend/dashboard

COPY frontend/dashboard/package.json frontend/dashboard/package-lock.json ./
RUN npm ci

COPY frontend/dashboard ./
RUN npm run build

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY Milestone_1 ./Milestone_1
COPY --from=frontend-build /app/frontend/dashboard/dist ./frontend/dashboard/dist

EXPOSE 8888

CMD ["python", "Milestone_1/dashboard_gateway/gateway_server.py", "--host", "0.0.0.0", "--port", "8888", "--replay", "http://replay:8775", "--live", "http://host.docker.internal:8765"]
