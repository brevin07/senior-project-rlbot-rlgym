FROM rust:1.86-slim AS rrrocket-build

ARG RRROCKET_VERSION=v0.11.1

RUN cargo install --git https://github.com/nickbabcock/rrrocket --tag ${RRROCKET_VERSION} rrrocket

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    RRROCKET_BIN=/usr/local/bin/rrrocket

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip install --no-cache-dir --upgrade pip

COPY --from=rrrocket-build /usr/local/cargo/bin/rrrocket /usr/local/bin/rrrocket
COPY requirements.txt ./requirements.txt
COPY requirements ./requirements
COPY configs ./configs

RUN python -m pip install --no-cache-dir -r requirements.txt && \
    python -m pip install --no-cache-dir pandas "PyJWT[crypto]>=2.8,<3" && \
    mkdir -p /app/artifacts/data

COPY rocketcoach ./rocketcoach
COPY collision_meshes ./collision_meshes
COPY dist ./dist
RUN test -f /app/dist/RLBotStackInstaller.exe

EXPOSE 8775

CMD ["python", "-m", "rocketcoach.replay_dashboard.run_replay_dashboard", "--host", "0.0.0.0", "--port", "8775", "--no-browser"]
